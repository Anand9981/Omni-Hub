# ==============================================================================
# OmniHub Backend .gitignore
# ==============================================================================

# 🛑 CRITICAL SECURITY: Never commit actual environment files containing secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env.*

# Allow committing template example files
!.env.example
!.env.*.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic & coverage reports
coverage/
.nyc_output/

# OS metadata
.DS_Store
Thumbs.db

# IDE & Editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
