# ==============================================================================
# OmniHub Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Get from https://cloud.mongodb.com/ -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/omnihub?retryWrites=true&w=majority

# Cache & Message Broker (Upstash Redis)
# Get from https://upstash.com/ -> Create Database -> Node.js / Redis URI
REDIS_URL=rediss://default:<password>@xxx.upstash.io:6379

# Authentication (JWT)
# Generate random 32+ character strings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=40h
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Media Storage
# Get from https://cloudinary.com/ -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Nodemailer / Gmail SMTP (Email OTP & Notifications)
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_character_app_password
EMAIL_FROM="OmniHub Support <your_email@gmail.com>"

# Telegram Bot
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Bot
# Get from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_BOT_TOKEN=your_discord_bot_token

# WhatsApp Cloud API (Meta for Developers)
# Get from https://developers.facebook.com/ -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Instagram Graph API (Meta for Developers)
# Get from https://developers.facebook.com/ -> Instagram Graph API
INSTAGRAM_VERIFY_TOKEN=your_custom_instagram_verify_token
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# Sentry Error Tracking & Performance Monitoring
# Get from https://sentry.io/ -> Settings -> Client Keys (DSN)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project_id>
