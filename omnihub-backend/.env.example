# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/omnihub

# Redis (Upstash / Local)
REDIS_URL=redis://localhost:6379

# JWT Secret & Expiry
JWT_SECRET=omnihub_super_secret_jwt_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=omnihub_super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Platform Webhook Verification Tokens / Secrets
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
WHATSAPP_VERIFY_TOKEN=omnihub_whatsapp_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
INSTAGRAM_VERIFY_TOKEN=omnihub_instagram_verify_token
INSTAGRAM_APP_SECRET=your_instagram_app_secret

