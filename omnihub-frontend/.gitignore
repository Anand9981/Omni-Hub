# ==============================================================================
# OmniHub Frontend .gitignore
# ==============================================================================

# 🛑 CRITICAL SECURITY: Never commit actual environment files containing secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env.*

# Allow committing template example files
!.env.example
!.env.*.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build output
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor directories
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db
